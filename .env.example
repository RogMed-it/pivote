# Google AdSense (Netlify → Site configuration → Environment variables).
# Sin VITE_ADSENSE_CLIENT no se carga ningún anuncio. Con él, el build genera /ads.txt.
# Opcional: el ID ca-pub-3963398476293536 ya viene por defecto en el código.
# VITE_ADSENSE_CLIENT=ca-pub-3963398476293536
# IDs de bloque (AdSense → Anuncios → Por bloque de anuncios → Display, adaptable).
VITE_ADSENSE_SLOT_RESULT=0000000000
VITE_ADSENSE_SLOT_FOOTER=0000000000

# Opcional: cuentas e historial en la nube con Supabase. Sin ellas, el historial vive en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
